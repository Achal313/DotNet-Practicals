@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h1 class="fw-bold">Vehicle Rental Management System</h1>
        <p class="text-muted">
            Welcome to your rental management dashboard.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-xl-3 col-md-6">
            <div class="card dashboard-card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="text-muted">Total Vehicles</h6>
                            <h2 class="fw-bold">@ViewBag.TotalVehicles</h2>
                        </div>
                        <div class="fs-1">🚗</div>
                    </div>

                    <a asp-controller="Vehicle"
                       asp-action="Index"
                       class="btn btn-primary btn-sm mt-3">
                        Manage Vehicles
                    </a>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card dashboard-card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="text-muted">Available Vehicles</h6>
                            <h2 class="fw-bold">@ViewBag.AvailableVehicles</h2>
                        </div>
                        <div class="fs-1">✅</div>
                    </div>

                    <a asp-controller="Vehicle"
                       asp-action="Index"
                       class="btn btn-success btn-sm mt-3">
                        View Vehicles
                    </a>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card dashboard-card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="text-muted">Total Customers</h6>
                            <h2 class="fw-bold">@ViewBag.TotalCustomers</h2>
                        </div>
                        <div class="fs-1">👤</div>
                    </div>

                    <a asp-controller="Customer"
                       asp-action="Index"
                       class="btn btn-info btn-sm mt-3">
                        Manage Customers
                    </a>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card dashboard-card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="text-muted">Total Bookings</h6>
                            <h2 class="fw-bold">@ViewBag.TotalBookings</h2>
                        </div>
                        <div class="fs-1">📅</div>
                    </div>

                    <a asp-controller="RentalBooking"
                       asp-action="Index"
                       class="btn btn-warning btn-sm mt-3">
                        View Bookings
                    </a>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4 mt-2">

        <div class="col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h5 class="fw-bold mb-3">
                        💰 Total Revenue
                    </h5>

                    <h1 class="fw-bold text-success">
                        ₹ @ViewBag.TotalRevenue.ToString("N2")
                    </h1>

                    <p class="text-muted">
                        Revenue from completed rental bookings.
                    </p>

                    <a asp-controller="Payment"
                       asp-action="Index"
                       class="btn btn-outline-success">
                        View Payments
                    </a>

                </div>

            </div>

        </div>

        <div class="col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h5 class="fw-bold mb-3">
                        ⚡ Quick Actions
                    </h5>

                    <div class="d-grid gap-2">

                        <a asp-controller="Vehicle"
                           asp-action="Create"
                           class="btn btn-primary">
                            + Add New Vehicle
                        </a>

                        <a asp-controller="Customer"
                           asp-action="Create"
                           class="btn btn-success">
                            + Add New Customer
                        </a>

                        <a asp-controller="RentalBooking"
                           asp-action="Create"
                           class="btn btn-warning">
                            + Create Rental Booking
                        </a>

                        <a asp-controller="Payment"
                           asp-action="Create"
                           class="btn btn-dark">
                            + Record Payment
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>