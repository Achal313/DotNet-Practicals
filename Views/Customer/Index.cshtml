@model IEnumerable<VehicleRentalManagementSystem.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Customer Management</h2>
            <p class="text-muted">Manage registered customers.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Add Customer
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Driving License</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.CustomerId</td>

                                <td class="fw-semibold">
                                    @item.Name
                                </td>

                                <td>
                                    @item.Email
                                </td>

                                <td>
                                    @item.Phone
                                </td>

                                <td>
                                    @item.DrivingLicenseNo
                                </td>

                                <td>

                                    <div class="btn-group">

                                        <a asp-action="Details"
                                           asp-route-id="@item.CustomerId"
                                           class="btn btn-sm btn-info">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.CustomerId"
                                           class="btn btn-sm btn-warning">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.CustomerId"
                                           class="btn btn-sm btn-danger">
                                            Delete
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <h5>No customers found</h5>

                    <p class="text-muted">
                        Add your first customer to the system.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        Add Customer
                    </a>

                </div>
            }

        </div>

    </div>

</div>