@model VehicleRentalManagementSystem.Models.Customer

@{
    ViewData["Title"] = "Customer Details";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">Customer Details</h4>
                </div>

                <div class="card-body">

                    <dl class="row">

                        <dt class="col-sm-4">
                            Customer ID
                        </dt>

                        <dd class="col-sm-8">
                            @Model.CustomerId
                        </dd>

                        <dt class="col-sm-4">
                            Name
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Name
                        </dd>

                        <dt class="col-sm-4">
                            Email
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Email
                        </dd>

                        <dt class="col-sm-4">
                            Phone
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Phone
                        </dd>

                        <dt class="col-sm-4">
                            Address
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Address
                        </dd>

                        <dt class="col-sm-4">
                            Driving License
                        </dt>

                        <dd class="col-sm-8">
                            @Model.DrivingLicenseNo
                        </dd>

                    </dl>

                    <div class="mt-3">

                        <a asp-action="Edit"
                           asp-route-id="@Model.CustomerId"
                           class="btn btn-warning">
                            Edit
                        </a>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Back
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>