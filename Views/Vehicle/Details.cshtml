@model VehicleRentalManagementSystem.Models.Vehicle

@{
    ViewData["Title"] = "Vehicle Details";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">Vehicle Details</h4>
                </div>

                <div class="card-body">

                    <dl class="row">

                        <dt class="col-sm-4">Vehicle ID</dt>
                        <dd class="col-sm-8">@Model.VehicleId</dd>

                        <dt class="col-sm-4">Vehicle Number</dt>
                        <dd class="col-sm-8">@Model.VehicleNumber</dd>

                        <dt class="col-sm-4">Vehicle Name</dt>
                        <dd class="col-sm-8">@Model.VehicleName</dd>

                        <dt class="col-sm-4">Vehicle Type</dt>
                        <dd class="col-sm-8">@Model.VehicleType</dd>

                        <dt class="col-sm-4">Brand</dt>
                        <dd class="col-sm-8">@Model.Brand</dd>

                        <dt class="col-sm-4">Model</dt>
                        <dd class="col-sm-8">@Model.Model</dd>

                        <dt class="col-sm-4">Rent Per Day</dt>
                        <dd class="col-sm-8">
                            ₹ @Model.RentPerDay
                        </dd>

                        <dt class="col-sm-4">Availability</dt>
                        <dd class="col-sm-8">
                            @if (Model.AvailabilityStatus == "Available")
                            {
                                <span class="badge bg-success">
                                    Available
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    @Model.AvailabilityStatus
                                </span>
                            }
                        </dd>

                    </dl>

                    <div class="mt-3">

                        <a asp-action="Edit"
                           asp-route-id="@Model.VehicleId"
                           class="btn btn-warning">
                            Edit
                        </a>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Back
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>