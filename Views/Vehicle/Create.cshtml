@model VehicleRentalManagementSystem.Models.Vehicle

@{
    ViewData["Title"] = "Add Vehicle";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Add New Vehicle</h4>
                </div>

                <div class="card-body">

                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="VehicleNumber"
                                       class="form-label"></label>

                                <input asp-for="VehicleNumber"
                                       class="form-control"
                                       placeholder="e.g. MH12AB1234" />

                                <span asp-validation-for="VehicleNumber"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="VehicleName"
                                       class="form-label"></label>

                                <input asp-for="VehicleName"
                                       class="form-control"
                                       placeholder="e.g. Swift" />

                                <span asp-validation-for="VehicleName"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="VehicleType"
                                       class="form-label"></label>

                                <select asp-for="VehicleType"
                                        class="form-select">

                                    <option value="">Select Type</option>
                                    <option value="Car">Car</option>
                                    <option value="Bike">Bike</option>
                                    <option value="SUV">SUV</option>
                                    <option value="Van">Van</option>

                                </select>

                                <span asp-validation-for="VehicleType"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Brand"
                                       class="form-label"></label>

                                <input asp-for="Brand"
                                       class="form-control"
                                       placeholder="e.g. Maruti" />

                                <span asp-validation-for="Brand"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Model"
                                       class="form-label"></label>

                                <input asp-for="Model"
                                       class="form-control"
                                       placeholder="e.g. 2025" />

                                <span asp-validation-for="Model"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="RentPerDay"
                                       class="form-label"></label>

                                <input asp-for="RentPerDay"
                                       type="number"
                                       step="0.01"
                                       class="form-control"
                                       placeholder="e.g. 1500" />

                                <span asp-validation-for="RentPerDay"
                                      class="text-danger"></span>
                            </div>

                        </div>

                        <div class="d-flex gap-2 mt-3">

                            <button type="submit"
                                    class="btn btn-primary">
                                Save Vehicle
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}