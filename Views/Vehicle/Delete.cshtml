@model VehicleRentalManagementSystem.Models.Vehicle

@{
    ViewData["Title"] = "Delete Vehicle";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Delete Vehicle</h4>
                </div>

                <div class="card-body">

                    <div class="alert alert-warning">
                        Are you sure you want to delete this vehicle?
                    </div>

                    <h5 class="fw-bold">
                        @Model.VehicleName
                    </h5>

                    <p>
                        <strong>Vehicle Number:</strong>
                        @Model.VehicleNumber
                    </p>

                    <p>
                        <strong>Brand:</strong>
                        @Model.Brand
                    </p>

                    <p>
                        <strong>Model:</strong>
                        @Model.Model
                    </p>

                    <form asp-action="Delete" method="post">

                        <input type="hidden"
                               asp-for="VehicleId" />

                        <button type="submit"
                                class="btn btn-danger">
                            Yes, Delete
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Cancel
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>