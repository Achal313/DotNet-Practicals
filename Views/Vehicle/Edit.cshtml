@model VehicleRentalManagementSystem.Models.Vehicle

@{
    ViewData["Title"] = "Edit Vehicle";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-warning">
                    <h4 class="mb-0">Edit Vehicle</h4>
                </div>

                <div class="card-body">

                    <form asp-action="Edit" method="post">

                        <input type="hidden" asp-for="VehicleId" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="VehicleNumber"
                                       class="form-label"></label>

                                <input asp-for="VehicleNumber"
                                       class="form-control" />

                                <span asp-validation-for="VehicleNumber"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="VehicleName"
                                       class="form-label"></label>

                                <input asp-for="VehicleName"
                                       class="form-control" />

                                <span asp-validation-for="VehicleName"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="VehicleType"
                                       class="form-label"></label>

                                <select asp-for="VehicleType"
                                        class="form-select">

                                    <option value="Car">Car</option>
                                    <option value="Bike">Bike</option>
                                    <option value="SUV">SUV</option>
                                    <option value="Van">Van</option>

                                </select>

                                <span asp-validation-for="VehicleType"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Brand"
                                       class="form-label"></label>

                                <input asp-for="Brand"
                                       class="form-control" />

                                <span asp-validation-for="Brand"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Model"
                                       class="form-label"></label>

                                <input asp-for="Model"
                                       class="form-control" />

                                <span asp-validation-for="Model"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="RentPerDay"
                                       class="form-label"></label>

                                <input asp-for="RentPerDay"
                                       type="number"
                                       step="0.01"
                                       class="form-control" />

                                <span asp-validation-for="RentPerDay"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="AvailabilityStatus"
                                       class="form-label"></label>

                                <select asp-for="AvailabilityStatus"
                                        class="form-select">

                                    <option value="Available">
                                        Available
                                    </option>

                                    <option value="Rented">
                                        Rented
                                    </option>

                                    <option value="Maintenance">
                                        Maintenance
                                    </option>

                                </select>

                                <span asp-validation-for="AvailabilityStatus"
                                      class="text-danger"></span>
                            </div>

                        </div>

                        <div class="d-flex gap-2 mt-3">

                            <button type="submit"
                                    class="btn btn-warning">
                                Update Vehicle
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}